{
  "$schema": "../schema/primitives.schema.json",
  "specVersion": "0.6.1",
  "basePalette": {
    "comment": "通用浅色基准：右侧主内容冷白、左侧导航浅灰、参考主色为珊瑚红。产品强调色由 accents 产品轴覆盖，皮肤切换不得改变强调色。",
    "mainBackground": "#F7F9FC",
    "sideBackground": "#F3F5F8",
    "primary": "#FF5A4D"
  },
  "spacing": {
    "comment": "4 的倍数刻度；组件内部微调可用半档（2/6/10），页面级只用下列值",
    "x1": 4,
    "x2": 8,
    "x3": 12,
    "x4": 16,
    "x6": 24,
    "x8": 32
  },
  "radii": {
    "control": 10,
    "card": 14,
    "menu": 12,
    "sheet": 18,
    "dialog": 20,
    "pill": 999,
    "checkbox": 5,
    "tooltip": 8
  },
  "iconography": {
    "policy": "优先使用各平台系统图标；同一产品内保持 rounded/outlined 视觉一致，不混用实心与描边表达同一状态。",
    "sizes": {
      "compact": 16,
      "regular": 20,
      "large": 24,
      "display": 32
    },
    "opticalStroke": {
      "compact": 1.75,
      "regular": 1.75,
      "large": 1.5
    }
  },
  "typography": {
    "fontPolicy": {
      "family": "system-ui",
      "fallback": [],
      "usePlatformTextStyles": true,
      "allowProductContentFonts": true
    },
    "weights": {
      "comment": "界面层使用 regular / medium / semibold；内容层字体由产品登记。",
      "body": 400,
      "emphasis": 500,
      "strong": 600
    },
    "componentRoles": {
      "pageTitle": "pageTitle",
      "sectionTitle": "sectionTitle",
      "dialogTitle": "sectionTitle",
      "listTitle": "label",
      "listSubtitle": "bodySecondary",
      "inputText": "body",
      "buttonLabel": "label",
      "desktopNavigation": "body",
      "mobileNavigation": "captionSmall",
      "metadata": "caption"
    }
  },
  "componentProfiles": {
    "mobile": {
      "label": "Mobile",
      "platforms": ["iOS", "iPadOS", "Android"],
      "unit": "logical px",
      "inputMode": "touch",
      "fontFamily": "系统 UI 字体",
      "scaling": "跟随系统字体缩放",
      "reference": {
        "name": "Kai Mobile UI · constrained by Apple HIG and Material 3",
        "url": "https://github.com/robeshell/kai-brand-design"
      },
      "typeScale": {
        "displayLarge": { "fontSize": 34, "lineHeight": 42, "fontWeight": 600, "letterSpacing": 0 },
        "pageTitle": { "fontSize": 28, "lineHeight": 36, "fontWeight": 600, "letterSpacing": 0 },
        "sectionTitle": { "fontSize": 22, "lineHeight": 28, "fontWeight": 600, "letterSpacing": 0 },
        "title": { "fontSize": 17, "lineHeight": 24, "fontWeight": 600, "letterSpacing": 0 },
        "body": { "fontSize": 17, "lineHeight": 24, "fontWeight": 400, "letterSpacing": 0 },
        "bodySecondary": { "fontSize": 15, "lineHeight": 20, "fontWeight": 400, "letterSpacing": 0 },
        "label": { "fontSize": 16, "lineHeight": 22, "fontWeight": 600, "letterSpacing": 0 },
        "caption": { "fontSize": 13, "lineHeight": 18, "fontWeight": 400, "letterSpacing": 0 },
        "captionSmall": { "fontSize": 11, "lineHeight": 16, "fontWeight": 500, "letterSpacing": 0 }
      },
      "metrics": {
        "minimumInteractiveTarget": 48,
        "controlHeight": 48,
        "compactControlHeight": 40,
        "listRowSingle": 52,
        "listRowDouble": 68,
        "pageGutter": 16,
        "sectionGap": 24,
        "controlGap": 12,
        "iconTextGap": 8
      }
    },
    "desktop": {
      "label": "Desktop",
      "platforms": ["macOS", "Windows", "Linux"],
      "unit": "logical px",
      "inputMode": "pointer / keyboard",
      "fontFamily": "系统 UI 字体",
      "scaling": "跟随系统显示与字体缩放",
      "reference": {
        "name": "Kai Desktop UI · constrained by macOS, Fluent and GNOME HIG",
        "url": "https://github.com/robeshell/kai-brand-design"
      },
      "typeScale": {
        "displayLarge": { "fontSize": 32, "lineHeight": 40, "fontWeight": 600, "letterSpacing": 0 },
        "pageTitle": { "fontSize": 24, "lineHeight": 32, "fontWeight": 600, "letterSpacing": 0 },

    }
  },
  "derivedAlphas": {
    "comment": "全品牌通用的派生透明度；实现方不得另行发明数值",
    "border": {
      "light": "black@0.08",
      "dark": "white@0.10"
    },
    "hairline": {
      "light": "black@0.055",
      "dark": "white@0.065"
    },
    "disabledBorder": {
      "light": "black@0.04",
      "dark": "white@0.05"
    },
    "subtleFill": {
      "light": "black@0.045",
      "dark": "white@0.055"
    },
    "disabledSubtle": {
      "light": "black@0.024",
      "dark": "white@0.028"
    },
    "stateLayer": {
      "hover": "foreground@0.055~0.065",
      "pressed": "foreground@0.10",
      "focused": "accent@0.16"
    },
    "selection": {
      "rowOrSurface": "foreground@0.05~0.055",
      "accentIndicator": "accent@0.10~0.14",
      "chipSelected": "accent@0.09",
      "listTileSelected": "accent@0.035"

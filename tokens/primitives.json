      "pressed": "error@0.16",
      "disabled": "error@0.025"
    },
    "status": {
      "success": {
        "light": "#237A57",
        "dark": "#5BC89A"
      },
      "warning": {
        "light": "#9A640D",
        "dark": "#E3AC45"
      },
      "error": {
        "light": "#B42318",
        "dark": "#FF7B72"
      },

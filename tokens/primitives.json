        "bodySecondary": { "fontSize": 12, "lineHeight": 18, "fontWeight": 400, "letterSpacing": 0 },
        "label": { "fontSize": 14, "lineHeight": 20, "fontWeight": 600, "letterSpacing": 0 },
        "caption": { "fontSize": 12, "lineHeight": 16, "fontWeight": 400, "letterSpacing": 0 },
        "captionSmall": { "fontSize": 11, "lineHeight": 16, "fontWeight": 500, "letterSpacing": 0 }
      },
      "metrics": {
        "minimumInteractiveTarget": 32,
        "controlHeight": 36,
        "compactControlHeight": 32,
        "listRowSingle": 40,
        "listRowDouble": 52,
        "pageGutter": 24,
        "sectionGap": 24,
        "controlGap": 8,
        "iconTextGap": 8
      }
    }
  },

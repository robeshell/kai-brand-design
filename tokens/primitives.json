  "motion": {
    "uiFast": {
      "durationMs": 140,
      "curve": "easeOut"
    },
    "uiStandard": {
      "durationMs": 160,
      "curve": "easeOutCubic"
    },
    "paletteTransition": {
      "durationMs": 420,
      "comment": "皮肤/配色切换；深夜皮肤 520"
    },
    "ambient": {
      "durationS": 14,
      "comment": "环境动效（氛围背景等），reduced-motion 时按 motionStrength 衰减"
    }
  },
  "breakpoints": {
    "windowClass": {
      "compact": "width <= 600 或 height < 600（移动）",
      "medium": "桌面 width < 1100；移动 width < 1000",
      "wide": "桌面 width >= 1100；移动 width >= 1000"
    },
    "mobileShell": "非桌面平台且（width < 820 或 height < 600）",
    "menuAdaptive": 680,
    "settingsMaxContentWidth": 920
  },
  "layoutMetrics": {
    "pageGutter": {
      "compact": 16,
      "medium": 24,
      "wide": 32
    },
    "contentBottomPadding": {
      "mobileShell": 140,
      "desktop": 96
    },
    "sidebarWidth": {
      "medium": 216,
      "wide": 236
    },
    "titlebarInset": {
      "macOS": 38,
      "windows": 44
    },
    "desktopWindow": {
      "comment": "主窗口逻辑像素（content size）；首次打开居中；可视区不足时钳到 min 与 visibleFrame−80 之间。辅窗（工具窗）属产品层。",
      "defaultWidth": 1280,
      "defaultHeight": 800,
      "minWidth": 1024,
      "minHeight": 700

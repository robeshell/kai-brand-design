          },
          {
            "accent": "#6673C7",
            "hover": "#7884D2",
            "id": "indigo",
            "name": "靛蓝",
            "pressed": "#5360AE"
          },
          {
            "accent": "#3F9E98",
            "hover": "#51ADA7",
            "id": "teal",
            "name": "青绿",
            "pressed": "#338781"
          },
          {
            "accent": "#C7842F",
            "hover": "#D4953F",
            "id": "amber",
            "name": "暖金",
            "pressed": "#AB6E24"

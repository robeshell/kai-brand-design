      "uiFast": {
        "curve": "easeOut",
        "durationMs": 140
      },
      "uiStandard": {
        "curve": "easeOutCubic",
        "durationMs": 160
      }
    },
    "radii": {
      "card": 14,
      "checkbox": 5,
      "control": 10,
      "dialog": 20,
      "menu": 12,
      "pill": 999,
      "sheet": 18,
      "tooltip": 8
    },
    "spacing": {
      "comment": "4 的倍数刻度；组件内部微调可用半档（2/6/10），页面级只用下列值",
      "x1": 4,
      "x2": 8,
      "x3": 12,
      "x4": 16,
      "x6": 24,
      "x8": 32
    },
    "specVersion": "0.4.0",
    "tapTargets": {

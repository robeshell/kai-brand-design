      "kaigua": {
        "default": "indigo",
        "displayName": "开刮",
        "note": "单值模型：hover/pressed 由通用 stateLayer 前景叠加表达，不设独立 accent hover 色",
        "presets": [
          {
            "accent": "#6673C7",
            "id": "indigo",
            "name": "靛蓝"
          },
          {

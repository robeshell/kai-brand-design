        "desktop": 96,
        "mobileShell": 140
      },
      "desktopWindow": {
        "comment": "主窗口逻辑像素（content size）；首次打开居中；可视区不足时钳到 min 与 visibleFrame−80 之间。辅窗（工具窗）属产品层。",
        "defaultHeight": 800,
        "defaultWidth": 1280,
        "minHeight": 700,
        "minWidth": 1024
      },
      "pageGutter": {
        "compact": 16,
        "medium": 24,
        "wide": 32
      },
      "sidebarWidth": {
        "medium": 216,
        "wide": 236
      },
      "titlebarInset": {
        "macOS": 38,
        "windows": 44
      }
    },
    "motion": {
      "ambient": {
        "comment": "环境动效（氛围背景等），reduced-motion 时按 motionStrength 衰减",
        "durationS": 14
      },
      "paletteTransition": {
        "comment": "皮肤/配色切换；深夜皮肤 520",

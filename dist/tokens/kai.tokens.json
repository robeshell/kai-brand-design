        "sectionSubtitle": 12.5
      },
      "tracking": {
        "headlineLarge": -0.8,
        "headlineMedium": -0.55,
        "pageTitle": -0.55,
        "titleLarge": -0.25
      },
      "weights": {
        "body": 400,
        "comment": "层级靠字重驱动（w600→w700→w800）+ 颜色（primary→secondary→muted），不靠字号堆叠",
        "display": 800,
        "emphasis": 600,
        "strong": 700
      }

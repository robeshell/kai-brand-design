{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robeshell.github.io/kai-brand-design/schema/skins.schema.json",
  "title": "Kai Brand Skin Tokens",
  "type": "object",
  "required": ["specVersion", "systemPseudoSkin", "presets"],
  "properties": {
    "specVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "systemPseudoSkin": {
      "type": "object",
      "required": ["id", "resolve"]
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "brightness",
          "canvas",
          "surface",
          "elevated",
          "overlay",
          "glass",
          "effects"
        ]
      }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robeshell.github.io/kai-brand-design/schema/component-contracts.schema.json",
  "title": "Kai Component Contracts",
  "type": "object",
  "required": ["contractVersion", "components"],
  "properties": {
    "contractVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "summary", "variants", "states", "accessibility", "usage", "tokens"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "description"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "description", "required"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "accessibility": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "usage": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "token", "value"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "token": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

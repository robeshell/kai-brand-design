{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robeshell.github.io/kai-brand-design/schema/primitives.schema.json",
  "title": "Kai Brand Primitive Tokens",
  "type": "object",
  "required": [
    "specVersion",
    "basePalette",
    "spacing",
    "radii",
    "typography",
    "motion",
    "tapTargets",
    "breakpoints",
    "layoutMetrics",
    "derivedAlphas"
  ],
  "properties": {
    "specVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "basePalette": {
      "type": "object",
      "required": ["mainBackground", "sideBackground", "primary"],
      "properties": {
        "mainBackground": { "type": "string" },
        "sideBackground": { "type": "string" },
        "primary": { "type": "string" }
      }
    },
    "spacing": {
      "type": "object",
      "required": ["x1", "x2", "x3", "x4", "x6", "x8"]
    },
    "radii": {
      "type": "object",
      "required": ["control", "card", "menu", "sheet", "dialog", "pill"]
    },
    "typography": {
      "type": "object",
      "required": ["fontFamily", "fontFamilyFallback", "weights", "tracking", "sizes"]
    },
    "motion": {
      "type": "object"
    },
    "tapTargets": {
      "type": "object"
    },
    "breakpoints": {
      "type": "object",
      "required": ["windowClass", "mobileShell", "menuAdaptive", "settingsMaxContentWidth"]
    },
    "layoutMetrics": {
      "type": "object",
      "required": [
        "pageGutter",
        "contentBottomPadding",
        "sidebarWidth",
        "titlebarInset",
        "desktopWindow"
      ]
    },
    "derivedAlphas": {
      "type": "object"
    }
  },
  "additionalProperties": true
}

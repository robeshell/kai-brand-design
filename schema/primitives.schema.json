{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robeshell.github.io/kai-brand-design/schema/primitives.schema.json",
  "title": "Kai Brand Primitive Tokens",
  "type": "object",
  "required": [
    "specVersion",
    "basePalette",
    "spacing",
    "radii",
    "iconography",
    "typography",
    "componentProfiles",
    "platformProfiles",
    "motion",
    "breakpoints",
    "layoutMetrics",
    "componentMetrics",
    "focusRing",
    "statusColors",
    "derivedAlphas"
  ],
  "properties": {
    "specVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "basePalette": {
      "type": "object",
      "required": ["mainBackground", "sideBackground", "primary"],
      "properties": {
        "mainBackground": { "type": "string" },
        "sideBackground": { "type": "string" },
        "primary": { "type": "string" }
      }
    },
    "spacing": {
      "type": "object",
      "required": ["x1", "x2", "x3", "x4", "x6", "x8"]
    },
    "radii": {
      "type": "object",
      "required": ["control", "card", "menu", "sheet", "dialog", "pill"]
    },
    "iconography": {
      "type": "object",
      "required": ["policy", "sizes", "opticalStroke"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "sizes": {
          "type": "object",
          "required": ["compact", "regular", "large", "display"]
        },
        "opticalStroke": {
          "type": "object",
          "required": ["compact", "regular", "large"]
        }
      }
    },
    "typography": {
      "type": "object",
      "required": ["fontPolicy", "weights", "semanticRoles", "componentMappings", "componentRoles"],
      "properties": {
        "fontPolicy": {
          "type": "object",
          "required": [
            "family",
            "fallback",
            "usePlatformTextStyles",
            "allowProductContentFonts"
          ]
        },
        "weights": {
          "type": "object",
          "required": ["body", "emphasis", "strong"]
        },
        "semanticRoles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/semanticRole" }
        },
        "componentMappings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "$ref": "#/$defs/componentMapping" }
          }
        },
        "componentRoles": {
          "type": "object",
          "required": [
            "pageTitle",
            "sectionTitle",
            "dialogTitle",
            "listTitle",
            "listSubtitle",
            "inputText",
            "buttonLabel",
            "desktopNavigation",
            "mobileNavigation",
            "metadata"
          ],
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "platformProfiles": {
      "type": "object",
      "required": [
        "appleMobile",
        "androidMobile",
        "macDesktop",
        "windowsDesktop",
        "linuxDesktop"
      ],
      "additionalProperties": { "$ref": "#/$defs/platformProfile" }
    },
    "componentProfiles": {
      "type": "object",
      "required": ["mobile", "desktop"],
      "additionalProperties": { "$ref": "#/$defs/platformProfile" }
    },
    "motion": {
      "type": "object"
    },
    "breakpoints": {
      "type": "object",
      "required": ["windowClass", "mobileShell", "menuAdaptive", "settingsMaxContentWidth"]
    },
    "layoutMetrics": {
      "type": "object",
      "required": [
        "pageGutter",
        "contentBottomPadding",
        "sidebarWidth",
        "titlebarInset",
        "desktopWindow",
        "contentWidth",
        "splitView"
      ]
    },
    "componentMetrics": {
      "type": "object",
      "required": ["dialog", "sheet", "menu", "table"]
    },
    "focusRing": {
      "type": "object",
      "required": ["width", "offset", "colorRole", "fallbackColorRole"]
    },
    "statusColors": {
      "type": "object",
      "required": ["success", "warning", "error", "info"]
    },
    "appearance": {
      "type": "object"
    },
    "derivedAlphas": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "textStyle": {
      "type": "object",
      "required": ["fontSize", "lineHeight", "fontWeight", "letterSpacing"],
      "properties": {
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
        "fontWeight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "letterSpacing": { "type": "number" }
      },
      "additionalProperties": false
    },
    "semanticRole": {
      "type": "object",
      "required": ["description", "intent", "allowedWeights"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "intent": { "type": "string", "minLength": 1 },
        "allowedWeights": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "enum": [400, 500, 600] }
        },
        "baseRole": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "componentMapping": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "profileOverrides": {
          "type": "object",
          "properties": {
            "mobile": { "$ref": "#/$defs/textStyle" },
            "desktop": { "$ref": "#/$defs/textStyle" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "platformProfile": {
      "type": "object",
      "required": [
        "label",
        "platforms",
        "unit",
        "inputMode",
        "fontFamily",
        "scaling",
        "reference",
        "typeScale",
        "metrics"
      ],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "unit": { "type": "string", "minLength": 1 },
        "inputMode": { "type": "string", "minLength": 1 },
        "fontFamily": { "type": "string", "minLength": 1 },
        "scaling": { "type": "string", "minLength": 1 },
        "reference": {
          "type": "object",
          "required": ["name", "url"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        },
        "typeScale": {
          "type": "object",
          "required": [
            "displayLarge",
            "pageTitle",
            "sectionTitle",
            "title",
            "body",
            "bodySecondary",
            "label",
            "caption",
            "captionSmall"
          ],
          "additionalProperties": { "$ref": "#/$defs/textStyle" }
        },
        "metrics": {
          "type": "object",
          "required": [
            "minimumInteractiveTarget",
            "controlHeight",
            "compactControlHeight",
            "listRowSingle",
            "listRowDouble",
            "pageGutter",
            "sectionGap",
            "controlGap",
            "iconTextGap"
          ],
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "additionalProperties": false
    }
  }
}
